# Copy this file to .env and fill in the lines marked `# FILL`.
# .env is gitignored.
#
# DO NOT commit a real .env. Anyone running this harness must provide
# their own Anthropic key and their own testnet wallet.

# ============================================================
# (1) Stage 2 — Claude API
#
# The behavioral simulator runs 5,000 trials by default, each one a
# Claude API call. Budget: roughly $1–$3 per agent at Sonnet 4.6 rates.
# Free-tier rate limits (30k tokens/min) cap the wall clock at ~30–60
# minutes; set ANTHROPIC_MAX_CONCURRENCY accordingly.
# ============================================================
ANTHROPIC_API_KEY=<YOUR_ANTHROPIC_API_KEY>             # FILL  — console.anthropic.com → API Keys
ANTHROPIC_MODEL_AGENT=claude-sonnet-4-6
ANTHROPIC_MODEL_JUDGE=claude-sonnet-4-6
ANTHROPIC_MAX_CONCURRENCY=2                            # raise on Tier 2+; lower on free tier
ANTHROPIC_MAX_RETRIES=8

# ============================================================
# (2) Stage 4 — Blockchain (real on-chain NFT issuance)
#
# A successful run will broadcast a transaction. Use a TESTNET wallet.
# Funded faucets:
#   • Base Sepolia:     https://www.coinbase.com/faucets/base-ethereum-sepolia-faucet
#   • Ethereum Sepolia: https://cloud.google.com/application/web3/faucet/ethereum/sepolia
# ============================================================
RPC_URL=https://sepolia.base.org                       # default Base Sepolia public RPC
CHAIN_ID=84532                                         # 84532 = Base Sepolia · 11155111 = Ethereum Sepolia

DEPLOYER_PRIVATE_KEY=<HEX_NO_0x_PREFIX>                # FILL  — testnet wallet private key (no 0x prefix)
ACE_UNDERWRITER_ADDRESS=<0x...>                        # FILL  — wallet address matching the key above

# Filled in by `uv run python -m nft.deploy` after first deploy.
# Re-runs of `nft.mint` read this address to know which contract to call.
ACE_IDENTITY_CONTRACT_ADDRESS=

# ============================================================
# (3) Simulation knobs (optional overrides)
# ============================================================
N_TRIALS=5000
RANDOM_SEED=42
